---
import Icon from '../ui/icon.astro'
import { bytes, count } from '../../lib/format'
import { MAX_STORAGE } from '../../lib/server/packages'

interface Props {
  handle: string
  used: number
  quota: number
  linked: boolean
  packages: { name: string; versions: number; size: number }[]
}

const { handle, used, quota, linked, packages } = Astro.props

// Every version of a package is stored, so the bar fills with what was published and never with what is live.
const filled = Math.min(100, Math.round((used / quota) * 100))
const full = used >= quota

/* A raised quota is a conversation, so the link opens one already holding what the answer depends on. */
const subject = `More room for @${handle}`
const body = `Handle: @${handle}\nUsing: ${bytes(used)} of ${bytes(quota)}\n\nWhat I publish and why I need more room:\n`
const ask = `mailto:c.sutton.dylan@gmail.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`
---

<div class="flex flex-col gap-6">
  <div>
    <h2 class="text-md">Storage</h2>
    <p class="text-fg-hint mt-0.5">The room your packages take, and what is left of it.</p>
  </div>

  <section class="flex flex-col gap-2">
    <h3 class="ml-4">Usage</h3>

    <div class="bg-page border border-line-strong rounded-2xl flex flex-col gap-3 px-4 py-3">
      <p class="flex flex-wrap items-baseline gap-x-2">
        <span class="tabular-nums">{bytes(used)}</span>
        <span class="text-fg-hint text-xs">of {bytes(quota)}</span>
        {full && <span class="text-2xs text-fg-hint">· no room left to publish</span>}
      </p>

      <div class="h-1.5 rounded-full bg-line-strong overflow-hidden">
        <div class:list={['h-full rounded-full', full ? 'bg-fg-subtle' : 'bg-fg-muted']} style={`width: ${filled}%`}></div>
      </div>

      <p class="text-2xs text-fg-hint">
        Every version counts, a yanked one included, since a published artifact is never deleted. <a href={ask} class="underline transition hover:text-fg">Ask for more room</a>
      </p>
    </div>

    {!linked && (
      <p class="ml-4 text-2xs text-fg-hint">Linking GitHub or Google raises this to {bytes(MAX_STORAGE)}. The smaller room on an address alone is what stops one person opening accounts for space.</p>
    )}
  </section>

  <section class="flex flex-col gap-2">
    <h3 class="ml-4">Packages</h3>

    {packages.length > 0 ? (
      <div class="bg-page border border-line-strong rounded-2xl overflow-hidden">
        <ul class="divide-y divide-line-strong">
          {packages.map((held) => (
            <li class="flex items-center gap-3 px-4 py-3">
              <Icon name="boxes" size="lg" class="shrink-0 text-fg-subtle" />

              <div class="min-w-0 flex-1">
                <p class="truncate"><a href={`/package/${held.name}`} class="underline">{held.name}</a></p>
                <p class="truncate text-2xs text-fg-hint">{count(held.versions)} {held.versions === 1 ? 'version' : 'versions'}</p>
              </div>

              <span class="shrink-0 tabular-nums text-xs text-fg-muted">{bytes(held.size)}</span>
            </li>
          ))}
        </ul>
      </div>
    ) : (
      <p class="ml-4 text-fg-hint">Nothing published yet.</p>
    )}
  </section>
</div>
