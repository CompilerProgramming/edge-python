---
import { env } from 'cloudflare:workers'
import Icon from './ui/icon.astro'

interface Props {
  code: string
  name?: string
  output?: string
  placeholder?: string
  minLines?: number
  maxLines?: number
  outputMaxLines?: number
  // Packages the examples import beyond the official ones, by name to pinned url.
  imports?: Record<string, string>
}

const { code, name, output = '', placeholder, minLines = 1, maxLines = 5, outputMaxLines = 5, imports } = Astro.props

const rows = Math.min(Math.max(code.split('\n').length, minLines), maxLines)

// What the example runs under, shown as the file it would be in a project.
const manifest = JSON.stringify(imports ? { imports } : {}, null, 2)

const panel = 'bg-panel rounded-2xl mb-6'
const card = 'bg-page border border-line-strong rounded-2xl overflow-hidden p-4'
const footer = 'flex items-center justify-between py-3 px-[17px] text-2xs text-fg-hint'
// The header's own menu, a group that opens on hover with the pages it holds beneath it.
const menu = 'invisible absolute left-0 top-full z-10 pt-2 opacity-0 -translate-y-1 transition-all group-hover/file:visible group-hover/file:opacity-100 group-hover/file:translate-y-0 group-focus-within/file:visible group-focus-within/file:opacity-100 group-focus-within/file:translate-y-0'
const pick = 'block w-full px-4 py-1 text-left text-fg-subtle hover:bg-line-strong hover:text-fg aria-current:bg-line-strong aria-current:text-fg transition'

// Each file is a textarea over the highlighted copy of itself.
const pane = '-m-4 grid overflow-auto font-mono leading-code [scrollbar-width:none] [&::-webkit-scrollbar]:hidden'
const paint = 'pointer-events-none col-start-1 row-start-1 m-0 whitespace-pre p-4 font-mono leading-code'
const colors = '[&_span]:text-(--shiki-light) dark:[&_span]:text-(--shiki-dark)'
const field = 'col-start-1 row-start-1 w-full resize-none overflow-hidden whitespace-pre border-0 bg-transparent p-4 font-mono leading-code text-transparent caret-fg outline-none placeholder:text-fg-placeholder selection:bg-link/30 selection:text-transparent'
const tall = `max-height:calc(${maxLines} * var(--leading-code) + 2rem)`
---

<div data-playground data-cdn={env.CDN} data-min={minLines} data-expected={output} data-imports={imports && JSON.stringify(imports)}>
  <div class={panel}>
    <div class:list={[card, 'text-xs']}>
      <div class={pane} style={tall}>
        <pre aria-hidden="true" class={paint}><code data-view class={colors}></code></pre>
        <textarea
          data-input name={name} rows={rows} placeholder={placeholder} spellcheck="false" autocomplete="off" autocapitalize="off" aria-label="Edge Python source"
          class={field}>{code}</textarea>
      </div>

      <div data-manifest hidden class={pane} style={tall}>
        <pre aria-hidden="true" class={paint}><code class={colors}></code></pre>
        <textarea rows={rows} spellcheck="false" autocomplete="off" autocapitalize="off" aria-label="edge.json" class={field}>{manifest}</textarea>
      </div>
    </div>

    <div class={footer}>
      <div class="group/file relative">
        <button type="button" class="flex items-center gap-1 text-fg-subtle transition hover:text-fg">
          <span data-file>main.py</span>
          <Icon name="next" size="sm" class="rotate-90 text-fg-hint transition-transform group-hover/file:-rotate-90 group-focus-within/file:-rotate-90" />
        </button>

        <div class={menu}>
          <div class="w-36 bg-surface border border-line rounded-2xl py-3 text-xs">
            {['main.py', 'edge.json'].map((each) => (
              <button type="button" data-pick={each} aria-current={each === 'main.py' ? 'true' : undefined} class={pick}>{each}</button>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class={panel}>
    <div class:list={[card, 'text-xs']}>
      <pre
        data-output
        class="-m-4 p-4 overflow-auto whitespace-pre font-mono leading-code [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
        style={`min-height:calc(${minLines} * var(--leading-code) + 2rem);max-height:calc(${outputMaxLines} * var(--leading-code) + 2rem)`}
      >{output}</pre>
    </div>

    <div class={footer}>
      <span data-status>Output</span>
    </div>
  </div>
</div>

<script>
  import { createEditor } from '../lib/playground/editor'
  import { createHighlight } from '../lib/playground/highlight'
  import { applyControls } from '../lib/playground/terminal'
  import { run, type Phase } from '../lib/playground/runtime'

  const PHASES: Record<Phase, string> = {
    runtime: 'loading runtime…',
    worker: 'initializing worker…',
    running: 'running…'
  }

  // How long typing pauses before the edit runs.
  const SETTLE = 400

  document.querySelectorAll<HTMLElement>('[data-playground]').forEach((root) => {
    const input = root.querySelector<HTMLTextAreaElement>('[data-input]')
    const view = root.querySelector<HTMLElement>('[data-view]')
    const output = root.querySelector<HTMLElement>('[data-output]')
    const status = root.querySelector<HTMLElement>('[data-status]')

    if (!input || !view || !output || !status) return

    const expected = root.dataset.expected ?? ''
    let running = false
    let queued = false
    let timer = 0
    // The source the output shows, so a pause that changed nothing runs nothing.
    let ran = input.value

    const highlight = createHighlight(() => {
      editor.refresh()
      json.refresh()
    })

    const editor = createEditor({
      input,
      view,
      highlight,
      onRun: () => start(),
      minLines: Number(root.dataset.min) || 1
    })

    const manifest = root.querySelector<HTMLElement>('[data-manifest]')!
    const json = createEditor({
      input: manifest.querySelector('textarea')!,
      view: manifest.querySelector('code')!,
      highlight,
      onRun: () => start(),
      minLines: input.rows,
      lang: 'json'
    })

    async function start() {
      if (running) return void (queued = true)
      running = true
      ran = editor.getCode()

      let buffer = ''

      try {
        const result = await run(
          ran,
          root.dataset.cdn!,
          (chunk) => {
            buffer += chunk
            output!.textContent = applyControls(buffer).replace(/\n$/, '')
          },
          (phase) => { status!.textContent = `Output, ${PHASES[phase]}` },
          JSON.parse(root.dataset.imports ?? '{}')
        )

        const text = applyControls(buffer).replace(/\n$/, '')
        output!.textContent = [text, result.error].filter(Boolean).join('\n')

        status!.textContent = result.error
          ? 'Output, failed'
          : expected && text.trimEnd() !== expected.trimEnd()
            ? 'Output, differs'
            : `Output, ${result.ms < 1000 ? `${result.ms.toFixed(0)}ms` : `${(result.ms / 1000).toFixed(2)}s`}`
      } catch (error) {
        output!.textContent = String((error as Error)?.message ?? error)
        status!.textContent = 'Output, failed'
      } finally {
        running = false
        if (queued) {
          queued = false
          settle()
        }
      }
    }

    // An edit runs once typing pauses, and one landing mid run waits for that run to end.
    const settle = () => {
      if (editor.getCode() !== ran) start()
    }

    input.addEventListener('input', () => {
      clearTimeout(timer)
      timer = window.setTimeout(settle, SETTLE)
    })

    // Picking a file swaps what the one box shows, and the menu marks the one now open.
    const source = input.parentElement!
    const open = root.querySelector<HTMLElement>('[data-file]')!
    const picks = root.querySelectorAll<HTMLButtonElement>('[data-pick]')

    picks.forEach((pick) =>
      pick.addEventListener('click', () => {
        const code = pick.dataset.pick === 'main.py'
        source.hidden = !code
        manifest.hidden = code
        open.textContent = pick.dataset.pick!
        picks.forEach((each) => (each === pick ? each.setAttribute('aria-current', 'true') : each.removeAttribute('aria-current')))
        pick.blur()
      })
    )
  })
</script>
