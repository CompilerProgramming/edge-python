---
import type { ComponentProps } from 'astro/types'
import Icon from './icon.astro'

type Link = { icon: ComponentProps<typeof Icon>['name']; label: string; detail: string; href: string }

interface Props {
  links: readonly Link[]
  // A detail that is a command reads in the code face.
  mono?: boolean
}

const { links, mono = false } = Astro.props
---

<ul class="bg-page border border-line-strong rounded-2xl overflow-hidden divide-y divide-line-strong">
  {links.map((link) => (
    <li>
      <a href={link.href} class="group flex items-center gap-3 px-4 py-3 transition hover:bg-surface focus-visible:outline-none focus-visible:bg-surface">
        <Icon name={link.icon} class="shrink-0 text-fg-subtle" />
        <div class="min-w-0 flex-1">
          <p class="text-sm">{link.label}</p>
          <p class:list={['truncate text-2xs text-fg-hint', mono && 'font-mono']}>{link.detail}</p>
        </div>
        <Icon name="arrow" size="sm" class="shrink-0 text-fg-hint opacity-0 -translate-x-1 transition group-hover:opacity-100 group-hover:translate-x-0 group-focus-visible:opacity-100 group-focus-visible:translate-x-0" />
      </a>
    </li>
  ))}
</ul>
