---
import type { Avatar } from '../../lib/account/avatar'

const SIZES = { sm: 'size-6 p-1', md: 'size-8.5 p-1.75', lg: 'size-10 p-2', xl: 'size-27 p-5' }

const glyphs = import.meta.glob<string>('../../assets/avatars/avatar-*.svg', { query: '?raw', import: 'default', eager: true })

// Widens the view evenly around the weight of the drawing, so a big ear no longer pulls the face aside.
const centered = (svg: string) => {
  const rects = [...svg.matchAll(/<rect x="(\d+)" y="\d+" width="(\d+)" height="(\d+)"/g)].map((m) => m.slice(1).map(Number))
  const area = rects.reduce((sum, [, w, h]) => sum + w! * h!, 0)
  const x = rects.reduce((sum, [x, w, h]) => sum + (x! + w! / 2) * w! * h!, 0) / area
  const half = Math.max(x - Math.min(...rects.map(([x]) => x!)), Math.max(...rects.map(([x, w]) => x! + w!)) - x)

  return svg.replace(/viewBox="0 0 \d+ (\d+)"/, (_, height) => `viewBox="${Math.round(x - half)} 0 ${Math.round(2 * half)} ${height}"`)
}

interface Props extends Avatar {
  size?: keyof typeof SIZES
  label?: string
  class?: string
}

const { icon, palette, size = 'sm', label, class: className } = Astro.props

const glyph = Object.entries(glyphs).find(([path]) => path.endsWith(`/avatar-${icon}.svg`))?.[1]
if (!glyph) throw new Error(`Unknown avatar icon ${icon}.`)
---

<span
  class:list={[`avatar-${palette}`, 'inline-flex shrink-0 rounded-full bg-(--av-bg) [&>svg]:size-full', SIZES[size], className]}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  set:html={centered(glyph)}
/>
