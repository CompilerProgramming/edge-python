{/* Drawn over the site and shown only while it scrolls, since the native bar stays hidden. */}
<div data-scrollbar aria-hidden="true" class="pointer-events-none fixed right-0.5 top-0 z-50 w-1 rounded-full bg-fg-disabled opacity-0 transition-[opacity,background-color] duration-200 before:absolute before:inset-y-0 before:-inset-x-1.5 hover:bg-fg-hint data-dragging:bg-fg-hint data-shown:pointer-events-auto data-shown:opacity-100"></div>

<script>
  import { scrollbar } from '../../lib/scrollbar'

  const { moved } = scrollbar(document.querySelector<HTMLElement>('[data-scrollbar]')!, 'y', (offset) => scrollTo(scrollX, offset))
  addEventListener('scroll', () => moved({ offset: scrollY, view: innerHeight, total: document.documentElement.scrollHeight, track: innerHeight }), { passive: true })
</script>
